# Mach 1.3 planar shock running along a body with four deployed brake plates (3D, inviscid).
# Geometry: brake.stl as uploaded, used unscaled. Nose at x = 0, tail at x = 6.5,
# body radius about 1.0-1.12, plates at x = 4.77-4.98 reaching r = 2.28, one on each of the
# +y, -y, +z, -z axes. Lengths are in STL units.
# Gas units as in ../shock_wedge: still gas rho_1 = 1, p_1 = 1/gamma, c_1 = 1, shock speed W = 1.3.
#
# The body is symmetric about the planes y = 0 and z = 0, so only the quarter y >= 0, z >= 0
# is computed, with symmetry boundaries on those planes.
max_step  = 100000
stop_time = 6.0

geometry.coord_sys   = 0
geometry.prob_lo     = -2 0 0
geometry.prob_hi     = 10 5 5
geometry.is_periodic = 0 0 0

# Base grid dx = 0.125; with max_level = 2 and ratio 2 the finest dx = 0.03125,
# about 7 cells across a brake plate (0.21 thick).
amr.n_cell          = 96 40 40
amr.max_level       = 2
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2
amr.blocking_factor = 8
amr.max_grid_size   = 32
amr.n_error_buf     = 2
amr.grid_eff        = 0.7

# 0 interior, 1 inflow, 2 outflow, 3 symmetry, 4 slip wall, 5 no-slip wall
# x-lo: inflow of the post-shock state; x-hi: outflow
# y-lo, z-lo: symmetry planes through the body axis; y-hi, z-hi: outflow
cns.lo_bc = 1 3 3
cns.hi_bc = 2 2 2

cns.cfl       = 0.3
cns.do_visc   = 0
cns.do_reflux = 1
cns.refine_cutcells        = 1
cns.refine_max_dengrad_lev = 10
cns.refine_dengrad         = 0.01
cns.v = 0
amr.v = 1

amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_per          = 0.25   # write a plotfile every 0.25 time units
amr.derive_plot_vars  = pressure x_velocity y_velocity z_velocity

# Your STL: closed (every edge shared by two triangles), outward normals, already
# positioned, so no scaling or shift. Copy brake.stl into the run folder.
eb2.geom_type = stl
eb2.stl_file = brake.stl
eb2.stl_scale = 1
eb2.stl_center = 0 0 0
eb2.stl_reverse_normal = 0
eb2.stl_use_bvh = 1
eb2.cover_multiple_cuts = 1
# The thin plates cannot be coarsened from the finest EB, so build each level from the STL.
eb2.build_coarse_level_by_coarsening = 0

# Incident shock starts 1 length ahead of the nose (x = -1); it reaches the nose at
# t = 0.77, the brake plates at t = 4.4 and the tail at t = 5.8.
prob.mach    = 1.3
prob.x_shock = -1.0
prob.rho_1   = 1.0
prob.p_1     = 0.7142857142857143
