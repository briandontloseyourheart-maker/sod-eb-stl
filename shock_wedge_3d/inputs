# Mach 1.3 shock diffraction over a finite-span triangular wedge (3D, inviscid).
# Same units as ../shock_wedge: still gas rho_1 = 1, p_1 = 1/gamma, so c_1 = 1 and
# the shock speed is W = M = 1.3. Lengths are in wedge lengths L (apex to base).
#
# Only half the span is computed: z = 0 is the mid-span symmetry plane.
max_step  = 100000
stop_time = 1.3

geometry.coord_sys   = 0
geometry.prob_lo     = 0 -3 0
geometry.prob_hi     = 8  3 3
geometry.is_periodic = 0  0 0

# Base grid dx = L/16; with max_level = 2 and ratio 2 the finest dx = L/64.
# (The 2D case uses L/128; use max_level = 3 for that here, at several times the cost.)
amr.n_cell          = 128 96 48
amr.max_level       = 2
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2
amr.blocking_factor = 8
amr.max_grid_size   = 32
amr.n_error_buf     = 2
amr.grid_eff        = 0.7

# 0 interior, 1 inflow, 2 outflow, 3 symmetry, 4 slip wall, 5 no-slip wall
# x-lo: inflow of the post-shock state; x-hi: outflow
# y: slip walls; z-lo: mid-span symmetry plane; z-hi: slip wall
cns.lo_bc = 1 3 3
cns.hi_bc = 2 3 3

cns.cfl       = 0.3
cns.do_visc   = 0
cns.do_reflux = 1
cns.refine_cutcells        = 1
cns.refine_max_dengrad_lev = 10
cns.refine_dengrad         = 0.01
cns.v = 0
amr.v = 1

amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_per          = 0.1    # write a plotfile every 0.1 time units
amr.derive_plot_vars  = pressure x_velocity y_velocity z_velocity

# Wedge from STL (made by ../shock_wedge/tools/generate_wedge_stl.py --depth 2):
# equilateral triangle, apex upstream at (3, 0), base at x = 4, extruded over
# z in [-1, 1]. The computed half covers z in [0, 1], so the wedge's end face at
# z = 1 sits in the flow. Copy wedge3d.stl into the run folder.
eb2.geom_type = stl
eb2.stl_file = wedge3d.stl
eb2.stl_scale = 1
eb2.stl_center = 0 0 0
eb2.stl_reverse_normal = 0
eb2.stl_use_bvh = 1
eb2.cover_multiple_cuts = 1

# Incident shock starts at x = 2.5, reaches the apex at t = 0.385 and the base at t = 1.154.
prob.mach    = 1.3
prob.x_shock = 2.5
prob.rho_1   = 1.0
prob.p_1     = 0.7142857142857143
