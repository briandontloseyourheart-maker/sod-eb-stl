# Mach 1.3 shock diffraction over a finite triangular wedge (2D, inviscid).
# Units: still gas rho_1 = 1, p_1 = 1/gamma, so c_1 = 1 and the shock speed is
# W = M = 1.3. Lengths are in wedge lengths L (apex to base).
max_step  = 100000
stop_time = 1.3

geometry.coord_sys   = 0
geometry.prob_lo     = 0 -3
geometry.prob_hi     = 8  3
geometry.is_periodic = 0  0

# Base grid dx = 1/32; with max_level = 2 and ratio 2 the finest dx = L/128.
# For a sharper picture use max_level = 3 (dx = L/256).
amr.n_cell          = 256 192
amr.max_level       = 2
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2
amr.blocking_factor = 8
amr.max_grid_size   = 64
amr.n_error_buf     = 2
amr.grid_eff        = 0.7

# 0 interior, 1 inflow, 2 outflow, 3 symmetry, 4 slip wall, 5 no-slip wall
# x-lo: inflow of the post-shock state; x-hi: outflow; y: slip walls
cns.lo_bc = 1 3
cns.hi_bc = 2 3

cns.cfl       = 0.3
cns.do_visc   = 0
cns.do_reflux = 1
cns.refine_cutcells        = 1
cns.refine_max_dengrad_lev = 10
cns.refine_dengrad         = 0.01
cns.v = 0
amr.v = 1

amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_per          = 0.05   # write a plotfile every 0.05 time units
amr.derive_plot_vars  = pressure x_velocity y_velocity

# Wedge from an STL file, same shape as the implicit wedge in ./inputs.
# In 2D, AMReX cuts the STL with the plane z = 0, so the STL is a prism
# extruded in z (tools/generate_wedge_stl.py). Copy wedge.stl into the run folder.
eb2.geom_type = stl
eb2.cover_multiple_cuts = 1
eb2.stl_file = wedge.stl
eb2.stl_scale = 1
eb2.stl_center = 0 0 0
eb2.stl_reverse_normal = 0
eb2.stl_use_bvh = 1

# Incident shock starts at x = 2.5, reaches the apex at t = 0.385 and the base at t = 1.154.
prob.mach    = 1.3
prob.x_shock = 2.5
prob.rho_1   = 1.0
prob.p_1     = 0.7142857142857143
