# Mach 3 flow around a circular cylinder in a channel (2D, inviscid), cylinder from STL.
# Units: freestream rho = 1, p = 1/gamma, so c = 1 and u = M = 3. Lengths in cylinder
# diameters D (D = 1). Channel height 4 D with slip walls, as in the reference picture:
# the bow shock reflects off the walls and the reflected shocks cross the wake.
max_step  = 1000000
stop_time = 20.0

geometry.coord_sys   = 0
geometry.prob_lo     = 0 -2
geometry.prob_hi     = 16 2
geometry.is_periodic = 0 0

# Base grid dx = D/16; with max_level = 3 and ratio 2 the finest dx = D/128.
amr.n_cell          = 256 64
amr.max_level       = 3
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2
amr.blocking_factor = 8
amr.max_grid_size   = 64
amr.n_error_buf     = 2
amr.grid_eff        = 0.7

# 0 interior, 1 inflow, 2 outflow, 3 symmetry, 4 slip wall, 5 no-slip wall
# x-lo: supersonic inflow (freestream); x-hi: outflow; y: slip walls
cns.lo_bc = 1 3
cns.hi_bc = 2 3

cns.cfl       = 0.3
cns.do_visc   = 0
cns.do_reflux = 1
cns.refine_cutcells        = 1
cns.refine_max_dengrad_lev = 10
cns.refine_dengrad         = 0.05
cns.v = 0
amr.v = 1

amr.checkpoint_files_output = 1
amr.check_file        = chk
amr.check_per         = 5.0    # restart with amr.restart = chkXXXXX
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_per          = 0.1    # write a plotfile every 0.1 time units
amr.derive_plot_vars  = pressure x_velocity y_velocity

# Cylinder of diameter 1 centred at (1.9937, 0.0031), from tools/generate_cylinder_stl.py.
# The small offset keeps the cylinder's top, bottom, front and back off grid lines
# (tangent cut cells there are degenerate) and breaks the up-down symmetry so the
# wake starts shedding vortices.
# In 2D AMReX cuts the STL with the plane z = 0. Copy cylinder.stl into the run folder.
eb2.geom_type = stl
eb2.stl_file = cylinder.stl
eb2.stl_scale = 1
eb2.stl_center = 0 0 0
eb2.stl_reverse_normal = 0
eb2.stl_use_bvh = 1
eb2.cover_multiple_cuts = 1

# Start-up: freestream for x < 1, gas at rest elsewhere. The Mach 3 stream then
# enters behind a start-up shock that sweeps past the cylinder and out of the domain.
prob.x_start = 1.0
prob.mach = 3.0
prob.rho  = 1.0
prob.p    = 0.7142857142857143
